{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/whatsapp", "destination": "/api/whatsapp" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/cookies", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" }
  ]
}
